{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stapp",
  "version": "../package.json",
  "identifier": "com.stapp.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Stapp",
        "width": 1100,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "backgroundColor": "#1C2026"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; base-uri 'none'; object-src 'none'; frame-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: http: https:; font-src 'self' data:; media-src 'self' blob: http: https:; connect-src ipc: http://ipc.localhost http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFRTg0NkVCNzAxRTM1OEIKUldTTE5SNXc2MGJvL3A1WXJib3lrYzhSQWtDZDROUU9kY0dkQk9FNWhUY0h0QldXWll5Zml2WkQK",
      "endpoints": [
        "https://github.com/adeondev/Stapp/releases/latest/download/latest.json"
      ]
    }
  }
}
