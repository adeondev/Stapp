{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stapp",
  "version": "0.1.0",
  "identifier": "com.stapp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Stapp",
        "width": 1100,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1C2026"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; base-uri 'none'; object-src 'none'; frame-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
