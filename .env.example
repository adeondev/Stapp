# =======================================================================
# Stapp - Unified Docker Deployment Configuration
# =======================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#   docker compose up -d
# =======================================================================

# Server Name displayed in the UI
STAPP_SERVER_NAME="Stapp"

# Accessible Host IP or domain for other network participants
# (e.g., LAN: 192.168.1.100, Tailscale: 100.64.0.1, Radmin: 26.x.x.x, or Public IP)
# For local-only machine access, keep 127.0.0.1
STAPP_HOST_IP=127.0.0.1

# HTTP / WebSocket Server Port
STAPP_PORT=8787

# Registration & Authentication
STAPP_ALLOW_REGISTRATION=true
STAPP_TRUST_PRIVATE_NETWORKS=true

# LiveKit Media Server Ports
STAPP_LIVEKIT_PORT=7880
STAPP_LIVEKIT_TCP_PORT=7881
STAPP_LIVEKIT_UDP_PORT=7882

# LiveKit SFU Credentials (change these in production!)
STAPP_LIVEKIT_API_KEY=stapp_dev_key
STAPP_LIVEKIT_API_SECRET=stapp_dev_secret_must_be_at_least_32_chars_long

# Voice Backend Configuration
STAPP_VOICE_BACKEND=livekit
STAPP_VOICE_PUBLIC_URL=ws://127.0.0.1:7880
